<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>eu.inqudium</groupId>
        <artifactId>limesium</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>limesium-reactive-logging</artifactId>
    <name>limesium-reactive-logging</name>
    <description>WebFlux twin of limesium-servlet-logging: one structured endpoint_* line per HTTP exchange, identical fields and configuration</description>

    <dependencies>
        <!-- The shared twin code (ADR-0003). Inlined into this jar by the Shade plugin at package
             time and removed from the published POM (dependency-reduced POM), so consumers still add
             exactly one artifact. Compiled against with -Xfriend-paths (see the kotlin plugin below),
             which keeps the shared internals `internal`. -->
        <dependency>
            <groupId>eu.inqudium</groupId>
            <artifactId>limesium-common</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- A library, not an application: only what the auto-configuration and the properties class
             need - no starter, no logging/YAML transitives forced onto the host (architecture review
             finding 4). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- Used directly (fluent LoggingEventBuilder, MDC), so declared directly rather than inherited
             from a starter. The binding (Logback) is the host's. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- WebFilter, ServerWebExchange and the reactive request/response decorators live in spring-web;
             reactor-core supplies the reactive types. The module is a library - the reactive runtime
             (Netty) comes from the hosting application. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <!-- OPTIONAL by design: its presence on the host classpath opts in the endpoint_* MDC
             ThreadLocalAccessors. Handler-side MDC restoration around every operator ADDITIONALLY
             requires spring.reactor.context-propagation=auto (Boot's default 'limited' does not cover
             ordinary operators; the auto-configuration warns at startup when the prerequisite is
             missing). Absent, the module works unchanged without handler MDC. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>context-propagation</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- OPTIONAL by design: their presence is the opt-in for the coroutine filter variant
             (CoRequestLoggingWebFilter) - CoWebFilter needs -reactor, the handler-side MDC parity needs
             -slf4j's MDCContext. Absent, the Reactor variant registers and nothing changes. -->
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-reactor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-slf4j</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Real Netty + WebFlux runtime for the integration test; the module itself stays a library. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The other two reactive servers Boot 4 ships (Undertow left Boot with 4.0), for the per-server
             integration suites (ServerContract): the filter is server-agnostic by construction (WebFilter,
             DataBuffer tee), and the suites pin that the tee, the commit-deferred emission and the
             commit-action ordering hold on Tomcat's and Jetty's HttpHandler adapters as they do on
             Reactor Netty. Each suite declares its ReactiveWebServerFactory explicitly and asserts it,
             so the choice never depends on which server module Boot detects first. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jetty</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Real Micrometer Tracing (Brave bridge) for the tracing integration test. Unlike the servlet
             twin, this module does NOT read the bridge's MDC - it parses the caller's traceparent - so
             the test pins the two things that design promises against a real bridge: the logged traceId
             is the trace the server span runs under (the log-to-trace join holds), and the module never
             publishes the caller's parent span under the local spanId key. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-brave</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The Boot module above carries only the auto-configuration; the bridge itself and the
             ObservationRegistry auto-configuration (which the WebFlux observation filter is conditional
             on) must come explicitly. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-observation</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Fuzzing: the @FuzzTest classes under src/test/java (see
             CONTRIBUTING.md); version managed by the parent. -->
        <dependency>
            <groupId>com.code-intelligence</groupId>
            <artifactId>jazzer-junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
        <!-- The cross-stack contract files (configuration reference, ELK component template) live in
             the repository-shared /docs; the lockstep tests read them from the TEST CLASSPATH, so the
             dependency on the shared docs is declared HERE, in the build, rather than hidden in a
             relative path inside a test (architecture review finding 2). A missing checkout fails at
             resource processing with a clear message, not as a contract violation. -->
        <testResources>
            <testResource>
                <directory>${project.basedir}/src/test/resources</directory>
            </testResource>
            <testResource>
                <directory>${project.basedir}/../docs</directory>
                <includes>
                    <include>endpoint-logging-reference.yml</include>
                    <include>elk/limesium-servlet-logging-fields.component-template.json</include>
                </includes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <configuration>
                    <jvmTarget>${java.version}</jvmTarget>
                    <javaParameters>true</javaParameters>
                    <args>
                        <arg>-Xjsr305=strict</arg>
                        <!-- Friend access to limesium-common: the shared classes stay `internal`
                             although they live in another module (ADR-0003). The reactor builds
                             limesium-common first, so the classes directory exists. Paths are
                             basedir-relative (not session/execution-root properties): the IDE's
                             Maven import resolves ${project.basedir} into the Kotlin facet, while
                             session properties exist only at build time - an unresolved friend
                             path leaves every shared `internal` red in the editor. -->
                        <arg>-Xfriend-paths=${project.build.outputDirectory},${project.basedir}/../limesium-common/target/classes,${project.basedir}/../limesium-common/target/limesium-common-${project.version}.jar</arg>
                    </args>
                </configuration>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip> <!-- Skip repackaging - we're a library, not a standalone app -->
                </configuration>
            </plugin>
            <!-- The module page Dokka renders on the API-reference index; version,
                 sourceLinks and failOnWarning come from the parent's pluginManagement.
                 No executions: dokka:dokka is invoked on demand by the Docs workflow. -->
            <plugin>
                <groupId>org.jetbrains.dokka</groupId>
                <artifactId>dokka-maven-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>${project.basedir}/docs/api-module.md</include>
                    </includes>
                    <!-- The limesium-common sources are documented as part of THIS module: the shaded
                         jar contains those classes, and the twins' KDoc links to them must resolve
                         under failOnWarning. Listing sourceDirectories replaces the default, so the
                         module's own source root is repeated. -->
                    <sourceDirectories>
                        <dir>${project.basedir}/src/main/kotlin</dir>
                        <dir>${project.basedir}/../limesium-common/src/main/kotlin</dir>
                    </sourceDirectories>
                    <sourceLinks combine.self="override">
                        <link>
                            <path>src/main/kotlin</path>
                            <url>https://github.com/Inqudium/limesium/tree/main/${project.artifactId}/src/main/kotlin</url>
                            <lineSuffix>#L</lineSuffix>
                        </link>
                        <link>
                            <path>../limesium-common/src/main/kotlin</path>
                            <url>https://github.com/Inqudium/limesium/tree/main/limesium-common/src/main/kotlin</url>
                            <lineSuffix>#L</lineSuffix>
                        </link>
                    </sourceLinks>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
