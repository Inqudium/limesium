<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>eu.inqudium</groupId>
        <artifactId>limesium</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>limesium-servlet-logging</artifactId>
    <name>limesium-servlet-logging</name>
    <description>Auto-configured servlet filter that logs one structured line per HTTP exchange</description>
    <!-- Explicit, so the published (dependency-reduced) POM carries the homepage itself. -->
    <url>https://github.com/Inqudium/limesium</url>

    <properties>
        <!-- Test-only: the Undertow capture-boundary suite. Boot 4 dropped Undertow (no Servlet 6.1
             release exists), so the version is pinned here, not BOM-managed. -->
        <undertow.version>2.3.26.Final</undertow.version>
    </properties>

    <dependencies>
        <!-- The shared twin code (ADR-0003). Inlined into this jar by the Shade plugin at package
             time and removed from the published POM (dependency-reduced POM), so consumers still add
             exactly one artifact. Compiled against with -Xfriend-paths (see the kotlin plugin below),
             which keeps the shared internals `internal`. -->
        <dependency>
            <groupId>eu.inqudium</groupId>
            <artifactId>limesium-common</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- A library, not an application: only what the auto-configuration and the properties class
             need - no starter, no logging/YAML transitives forced onto the host (architecture review
             finding 4). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- Used directly (fluent LoggingEventBuilder, MDC), so declared directly rather than inherited
             from a starter. The binding (Logback) is the host's. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- OncePerRequestFilter and the servlet mocks' runtime types live in spring-web; the servlet API
             itself is provided by the hosting Tomcat application, hence scope provided. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Real embedded Tomcat + Spring MVC for the integration test; the module itself stays a library
             that only requires spring-web and a provided servlet API. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Second real container for the Jetty capture-boundary integration test: with Tomcat also on
             the classpath, Boot still auto-configures Tomcat everywhere; the Jetty test opts in via an
             explicit JettyServletWebServerFactory bean. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jetty</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Third engine, UNSUPPORTED territory (see the container-support note in the README):
             Boot 4 dropped its Undertow integration, so the Undertow capture-boundary test brings the
             engine itself and a minimal hand-rolled ServletWebServerFactory (UndertowTestServer).
             Version managed here explicitly - Undertow left the Boot BOM with the drop. -->
        <dependency>
            <groupId>io.undertow</groupId>
            <artifactId>undertow-servlet</artifactId>
            <version>${undertow.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Real Micrometer Tracing (Brave bridge) for the tracing integration test: pins the whole
             convention chain the trace capture rests on - observation filter order, scope-around-chain,
             MDC correlation - so a Boot upgrade that changes any of it breaks the build instead of
             silently dropping trace ids from the exchange events. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-brave</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The Boot module above carries only the auto-configuration; the bridge itself and the
             ObservationRegistry auto-configuration (which the WebMvc observation filter is conditional
             on) must come explicitly. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-observation</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Fuzzing: the @FuzzTest classes under src/test/java (see
             CONTRIBUTING.md); version managed by the parent. -->
        <dependency>
            <groupId>com.code-intelligence</groupId>
            <artifactId>jazzer-junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <configuration>
                    <jvmTarget>${java.version}</jvmTarget>
                    <javaParameters>true</javaParameters>
                    <args>
                        <arg>-Xjsr305=strict</arg>
                        <!-- Friend access to limesium-common: the shared classes stay `internal`
                             although they live in another module (ADR-0003). The reactor builds
                             limesium-common first, so the classes directory exists. Paths are
                             basedir-relative (not session/execution-root properties): the IDE's
                             Maven import resolves ${project.basedir} into the Kotlin facet, while
                             session properties exist only at build time - an unresolved friend
                             path leaves every shared `internal` red in the editor. -->
                        <arg>-Xfriend-paths=${project.build.outputDirectory},${project.basedir}/../limesium-common/target/classes,${project.basedir}/../limesium-common/target/limesium-common-${project.version}.jar</arg>
                    </args>
                </configuration>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip> <!-- Skip repackaging - we're a library, not a standalone app -->
                </configuration>
            </plugin>
            <!-- The module page Dokka renders on the API-reference index; version,
                 sourceLinks and failOnWarning come from the parent's pluginManagement.
                 No executions: dokka:dokka is invoked on demand by the Docs workflow. -->
            <plugin>
                <groupId>org.jetbrains.dokka</groupId>
                <artifactId>dokka-maven-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>${project.basedir}/docs/api-module.md</include>
                    </includes>
                    <!-- The limesium-common sources are documented as part of THIS module: the shaded
                         jar contains those classes, and the twins' KDoc links to them must resolve
                         under failOnWarning. Listing sourceDirectories replaces the default, so the
                         module's own source root is repeated. -->
                    <sourceDirectories>
                        <dir>${project.basedir}/src/main/kotlin</dir>
                        <dir>${project.basedir}/../limesium-common/src/main/kotlin</dir>
                    </sourceDirectories>
                    <sourceLinks combine.self="override">
                        <link>
                            <path>src/main/kotlin</path>
                            <url>https://github.com/Inqudium/limesium/tree/main/${project.artifactId}/src/main/kotlin</url>
                            <lineSuffix>#L</lineSuffix>
                        </link>
                        <link>
                            <path>../limesium-common/src/main/kotlin</path>
                            <url>https://github.com/Inqudium/limesium/tree/main/limesium-common/src/main/kotlin</url>
                            <lineSuffix>#L</lineSuffix>
                        </link>
                    </sourceLinks>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
